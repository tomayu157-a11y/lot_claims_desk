# Copy to .env and fill in. Every value is optional; the app runs without any
# of them, but degraded in the ways noted.

# Synthesis, planning, ranking and extraction. Without it the app uses the
# deterministic engine: real evidence and real citations, weaker prose.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Open-web fallback. Without it the fallback uses a keyless search path,
# which works but is less reliable than Firecrawl.
FIRECRAWL_API_KEY=

# Raises the NCBI E-utilities rate limit from 3/sec to 10/sec.
NCBI_API_KEY=
NCBI_EMAIL=research@example.org

# WHO ICD-11. Without these the ICD-11 connector reports "credentials not
# configured" and the ICD-11 leg of the code crosswalk stays unanswered.
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=

# LOINC search API. Same behaviour as above for lab and monitoring codes.
LOINC_USERNAME=
LOINC_PASSWORD=

# Blank means today.
RESEARCH_CUTOFF=
